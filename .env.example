# ---------------------------------------------------------------------------
# Infiotix Technologies – build-time configuration
#
# Copy this file to `.env.local` (local development) or `.env.production`
# (the Hostinger VPS) and fill in the values. NEVER commit the filled-in copy:
# only this example file is tracked.
#
# These values are read at BUILD time, so run `npm run build` again after any
# change here – editing the file on the server and only restarting PM2 will not
# pick them up.
# ---------------------------------------------------------------------------

# The exact public address of the live site, with no trailing slash.
# Everything search-related follows this value: canonical links, /sitemap.xml,
# /robots.txt, the share images and all structured data.
#
# Use the one spelling you have chosen as canonical. Infiotix uses the non-www
# form, so leave this as-is unless the canonical host really changes.
NEXT_PUBLIC_SITE_URL=https://infiotix.com

# Google Search Console "HTML tag" verification code.
# Search Console > Settings > Ownership verification > HTML tag gives you a
# string like <meta name="google-site-verification" content="XXXXXXXX" />.
# Put ONLY the content value here (no quotes, no tag).
# Optional: leave blank if the domain is already verified by DNS record.
GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools verification code (the `msvalidate.01` content value).
# Optional – leave blank if you are not using Bing Webmaster Tools.
BING_SITE_VERIFICATION=
